      "cell_type": "code",
      "source": [
        "print(f\"Original shape of plnu_df: {plnu_df.shape}\")\n",
        "\n",
        "# Define the column for outlier detection\n",
        "column_to_check = 'Mean_Bat_Speed_mph'\n",
        "\n",
        "# Calculate Q1, Q3, and IQR for the specified column\n",
        "Q1 = plnu_df[column_to_check].quantile(0.25)\n",
        "Q3 = plnu_df[column_to_check].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "# Define outlier bounds\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "# Filter out outliers\n",
        "plnu_df_bat_speed_cleaned = plnu_df[(plnu_df[column_to_check] >= lower_bound) & (plnu_df[column_to_check] <= upper_bound)]\n",
